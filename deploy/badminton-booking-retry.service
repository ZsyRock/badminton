[Unit]
Description=Retry missing Southampton Sport badminton bookings
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=<YOUR_USERNAME>
WorkingDirectory=/home/<YOUR_USERNAME>/badminton
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/home/<YOUR_USERNAME>
ExecStart=/home/<YOUR_USERNAME>/badminton/.venv/bin/python /home/<YOUR_USERNAME>/badminton/book_badminton.py --retry-missing
TimeoutStartSec=10min
NoNewPrivileges=true
